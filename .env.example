# LLM provider — any litellm-supported provider
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# Ledgerbooks mock ERP credentials (synthetic — do not use real credentials)
LB_USERNAME=admin
LB_PASSWORD=ledger123

# Mode: live | record | replay
LLM_MODE=replay

# Set to 0 to disable ERP uniqueness constraints (for chaos testing)
LB_ENFORCE_UNIQUE=1

# UI variant: v1 (default) | v2 (drift simulation)
LB_UI_VARIANT=v1

# Test mode (enables crash hooks and approvals-file)
# LH_TEST=1
# LH_CRASH_AT=after_dispatch:1
